# Copy this file to .env and fill in your real API keys.
# Never commit .env itself -- it is already in .gitignore.

# Groq API (generation) -- free tier, no credit card required
# Get key at: https://console.groq.com
GROQ_API_KEY=your-groq-key-here

# Cohere (reranking) -- free tier: 1000 calls/month, no card required
# Get key at: https://dashboard.cohere.com
COHERE_API_KEY=your-cohere-key-here